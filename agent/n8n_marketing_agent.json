    {
      "parameters": {
        "jsCode": "// Reached from \"Upload Image to Supabase\" (image made) or from the false branch of\n// \"Image Generated?\" (no image). Works out which, without assuming any node ran.\nconst base = $('Aggregate Generated Content').first().json;\nconst ran = name => { try { return $(name).isExecuted; } catch { return false; } };\nconst errText = e => (e && (e.message ?? (typeof e === 'string' ? e : JSON.stringify(e)))) || '';\n\nlet problem = null;\nconst gen = ran('Generate Image') ? $('Generate Image').first() : null;\nif (!gen) problem = 'the image step did not run';\nelse if (gen.json?.error) problem = errText(gen.json.error);\nelse if (!ran('Upload Image to Supabase')) problem = 'the image model returned no image file';\nelse if ($json.error) problem = 'upload to Supabase failed: ' + errText($json.error);\n\nif (problem) {\n  return [{ json: { ...base, imageUrl: null, warnings: [...(base.warnings || []), 'AI image could not be created: ' + problem + '. Upload one on the review page.'] } }];\n}\nreturn [{ json: { ...base, imageUrl: base.imageUpload.publicUrl } }];"
      },
      "id": "c29ef45e-91b0-586c-8ef2-a1a0e2a88d4e",
