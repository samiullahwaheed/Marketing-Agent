        "jsCode": "const b = $json.body ?? $json;\nconst allowed = ['linkedin', 'instagram', 'facebook'];\nif (!b.postId || !b.topic || !Array.isArray(b.platforms) || !b.platforms.length || !b.callbackUrl)\n  throw new Error('postId, topic, platforms and callbackUrl are required');\nif (b.platforms.some(p => !allowed.includes(p))) throw new Error('Unsupported platform in request');\n\nreturn [{ json: {\n  postId: String(b.postId),\n  topic: String(b.topic),\n  date: b.date ?? '',\n  time: b.time ?? '',\n  scheduledAt: b.scheduledAt ?? null,\n  postNow: Boolean(b.postNow),\n  platforms: b.platforms,\n  imageMode: b.imageMode ?? 'ai',\n  uploadedImageUrl: b.imageUrl ?? null,   // user upload, or image kept from the previous draft\n  imagePrompt: b.imagePrompt ?? '',\n  imageUpload: b.imageUpload ?? null,     // { signedUrl, publicUrl, path } for a new AI image\n  audience: b.audience ?? '',\n  language: b.language ?? '',\n  brandVoice: b.brandVoice ?? {},\n  bannedWords: Array.isArray(b.bannedWords) ? b.bannedWords : [],\n  rewrite: Boolean(b.rewrite),\n  rewriteRequest: b.rewriteRequest ?? null,\n  currentContent: b.currentContent ?? null,\n  callbackUrl: b.callbackUrl,\n} }];"
