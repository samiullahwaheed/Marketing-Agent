    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a {{ $json.platform }} post.\nTopic: {{ $json.topic }}\nAudience: {{ $json.audience || 'general' }}\nLanguage: {{ $json.language || 'English' }}\nBrand voice: {{ JSON.stringify($json.brandVoice || {}) }}\nNever use these words: {{ ($json.bannedWords || []).join(', ') || 'none' }}\nStyle: {{ $json.platformRules.style }}\nMaximum length: {{ $json.platformRules.maxCharacters }} characters including hashtags.\n{{ $json.rewrite ? 'This is a REWRITE. Current draft: ' + JSON.stringify(($json.currentContent || {})[$json.platform] || {}) + '\\nRequested changes: ' + ([...($json.rewriteRequest?.options || []), $json.rewriteRequest?.instructions].filter(Boolean).join('; ') || 'make it better') + ($json.rewriteRequest?.keepHashtags ? '\\nKeep the same hashtags.' : '') : '' }}",
        "hasOutputParser": true,
        "needsFallback": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are an expert social media copywriter. Write ready-to-publish copy tailored to the requested platform, its tone and its character limit. Put the post body in \"text\" WITHOUT hashtags; put 3-8 relevant hashtags (no # sign) in \"hashtags\" and extra optional ones in \"suggestedHashtags\". Add short notes to \"warnings\" for any claim, statistic or date the user should double-check; otherwise return an empty array. Never invent facts about the user's business."
            }
          ]
        },
        "batching": {}
