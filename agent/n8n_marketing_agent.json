    {
      "parameters": {
        "jsCode": "const generated = $input.all();\nconst bases = $('Platform Rules').all();\nconst req = $('Normalize Request').first().json;\nconst current = req.currentContent || {};\nconst clean = list => (Array.isArray(list) ? list : []).map(h => String(h).replace(/^#/, '').trim()).filter(Boolean);\n\nconst content = {};\nconst warnings = [];\nconst errors = [];\nfor (let i = 0; i < bases.length; i++) {\n  const platform = bases[i].json.platform;\n  const res = generated[i]?.json ?? {};\n  const raw = res.output ?? res;\n  const text = typeof raw === 'string' ? raw : (raw.text ?? '');\n  if (res.error || !text) {\n    errors.push(platform + ': ' + (res.error?.message ?? res.error ?? 'Claude returned no text'));\n    continue;\n  }\n  const keepTags = req.rewrite && req.rewriteRequest?.keepHashtags && clean(current[platform]?.hashtags).length;\n  content[platform] = {\n    text: String(text).trim(),\n    hashtags: keepTags ? clean(current[platform].hashtags) : clean(raw.hashtags),\n    suggestedHashtags: clean(raw.suggestedHashtags),\n  };\n  if (Array.isArray(raw.warnings)) warnings.push(...raw.warnings.map(String));\n}\n\nconst failed = Object.keys(content).length === 0;\nif (!failed) warnings.push(...errors.map(e => 'Could not write the ' + e));\nreturn [{ json: { ...req, content, warnings, failed, error: failed ? errors.join('; ') : null } }];"
      },
