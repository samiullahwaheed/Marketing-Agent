    {
      "parameters": {
        "jsCode": "// Your account IDs. Instagram needs the Instagram *Business* Account ID linked to the\n// Facebook Page (Graph API: GET /{page-id}?fields=instagram_business_account), not the Page ID.\nconst ACCOUNTS = {\n  facebookPageId: '1458689310655772',\n  instagramAccountId: 'REPLACE_WITH_INSTAGRAM_BUSINESS_ACCOUNT_ID',\n};\n\nconst b = $json.body ?? $json;\nconst allowed = ['linkedin', 'instagram', 'facebook'];\nif (!b.postId || !Array.isArray(b.platforms) || !b.platforms.length || !b.callbackUrl)\n  throw new Error('postId, platforms and callbackUrl are required');\nif (b.platforms.some(p => !allowed.includes(p))) throw new Error('Unsupported platform in request');\n\nconst withTags = c => {\n  const text = String(c?.text || '');\n  const tags = (Array.isArray(c?.hashtags) ? c.hashtags : [])\n    .map(h => '#' + String(h).replace(/^#/, ''))\n    .filter(h => !text.includes(h));\n  return tags.length ? text + '\\n\\n' + tags.join(' ') : text;\n};\n\nreturn [{ json: {\n  postId: String(b.postId),\n  scheduledAt: b.scheduledAt ?? null,\n  callbackUrl: b.callbackUrl,\n  platformPosts: b.platforms.map(platform => ({\n    platform,\n    message: withTags(b.content?.[platform]),\n    imageUrl: b.imageUrl ?? null,\n  })),\n  accounts: ACCOUNTS,\n} }];"
      },
