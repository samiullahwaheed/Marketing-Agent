        "jsCode": "const generated=$input.all();\nconst bases=$('Platform Rules').all();\nconst content={};\nconst warnings=[];\nfor(let i=0;i<generated.length;i++){\n const base=bases[i]?.json;\n const result=generated[i].json;\n const raw=result.output ?? result.content ?? result;\n const text=typeof raw==='string' ? raw : raw.text ?? raw.output ?? raw.post ?? result.text ?? result.output ?? result.post ?? result.message ?? '';\n if(!text) throw new Error('Content agent returned no text for '+base.platform);\n content[base.platform]={text:String(text),hashtags:Array.isArray(raw.hashtags)?raw.hashtags:(Array.isArray(result.hashtags)?result.hashtags:[]),suggestedHashtags:Array.isArray(raw.suggestedHashtags)?raw.suggestedHashtags:(Array.isArray(result.suggestedHashtags)?result.suggestedHashtags:[])};\n const itemWarnings=raw.warnings ?? result.warnings ?? result.flags ?? [];\n warnings.push(...(Array.isArray(itemWarnings)?itemWarnings:[String(itemWarnings)]));\n}\nconst base=bases[0].json;\nreturn [{json:{...base,platform:undefined,platforms:bases.map(item=>item.json.platform),content,warnings,hasUserImage:Boolean(base.uploadedImageUrl)}}];"
