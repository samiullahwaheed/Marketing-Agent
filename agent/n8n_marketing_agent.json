    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $('Platform Router').item.json;\nconst response = { ...$json };\nif (!response.url && response.urn) response.url = 'https://www.linkedin.com/feed/update/' + response.urn;\nif (!response.url && src.platform === 'x' && response.id) response.url = 'https://x.com/i/web/status/' + response.id;\nconst failed =\n  Boolean(response.error) || Number(response.statusCode ?? 200) >= 400;\nconst publishedAt = failed ? null : new Date().toISOString();\n\nconst platformResult = {\n  status: failed ? 'failed' : 'published',\n  ...(response.url ?? response.permalink ?? response.postUrl\n    ? { url: response.url ?? response.permalink ?? response.postUrl }\n    : {}),\n  ...(publishedAt ? { publishedAt } : {}),\n  ...(failed\n    ? {\n        error:\n          typeof response.error === 'string'\n            ? response.error\n            : JSON.stringify(response.error ?? response),\n      }\n    : {}),\n};\n\nconst platformResults = {\n  [src.platform]: platformResult,\n};\n\nreturn {\n  json: {\n    ...src,\n    platformResult,\n    platformResults,\n    publishStatus: platformResult.status,\n    publishedAt,\n  },\n};"
      },
