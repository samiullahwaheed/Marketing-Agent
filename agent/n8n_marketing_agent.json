    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $('Platform Router').item.json;\nconst r = { ...$json };\n// n8n's \"Bad request\" hides the platform's own reason; pull it out of whatever the node returned.\nconst e = r.error;\nconst graph = e?.error ?? r.cause?.error ?? r.response?.body?.error; // Facebook/Instagram Graph API body\nconst parts = e ? [\n  typeof e === 'string' ? e : e.message,\n  e.description ?? r.description,\n  graph?.message ?? graph?.error_user_msg,\n  graph?.code ? 'code ' + graph.code + (graph.error_subcode ? '/' + graph.error_subcode : '') : null,\n] : [];\nconst err = e\n  ? [...new Set(parts.filter(Boolean).map(String))].join(' | ') || JSON.stringify(e)\n  : (Number(r.statusCode ?? 200) >= 400 ? JSON.stringify(r) : null);\n\nlet url = r.url ?? r.permalink ?? r.postUrl ?? null;\nif (!err && !url) {\n  if (src.platform === 'linkedin' && (r.urn || r.id)) url = 'https://www.linkedin.com/feed/update/' + (r.urn || r.id);\n  if (src.platform === 'facebook' && (r.post_id || r.id)) url = 'https://www.facebook.com/' + (r.post_id || r.id);\n}\n\nconst result = err\n  ? { status: 'failed', error: err }\n  : { status: 'published', ...(url ? { url } : {}), publishedAt: new Date().toISOString() };\n\nreturn { json: {\n  postId: src.postId,\n  callbackUrl: src.callbackUrl,\n  platform: src.platform,\n  platformResults: { [src.platform]: result },\n} };"
      },
