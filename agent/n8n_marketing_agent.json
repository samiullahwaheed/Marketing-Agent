        "mode": "runOnceForEachItem",
        "jsCode": "const rules = {\n  linkedin: { maxCharacters: 3000, style: 'professional, first-person, short paragraphs, a question at the end' },\n  instagram: { maxCharacters: 2200, style: 'visual and engaging, line breaks, caption for an image' },\n  facebook: { maxCharacters: 63206, style: 'conversational and warm' },\n};\n// Runs once per platform item coming out of \"Split Platforms\".\nreturn { json: { ...$json, platformRules: rules[$json.platform] ?? { maxCharacters: 2000, style: 'social' } } };"
      },
